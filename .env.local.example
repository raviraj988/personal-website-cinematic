# Supabase credentials for the blog and admin console.
#
# Copy to `.env.local` and fill in from the Supabase dashboard:
#   Project settings → API
#
# `.env.local` is already covered by .gitignore. Never commit real values.
#
# Note what is NOT here: the site's canonical origin. That is a hardcoded
# constant in `src/lib/blog/config.ts` on purpose — an origin that goes missing
# from the environment produces an empty sitemap and no canonical tags, and
# nothing fails loudly enough to notice.

# Project URL — the BARE origin, with no path after the hostname:
#
#   https://abcdefghijklmnop.supabase.co         correct
#   https://abcdefghijklmnop.supabase.co/rest/v1/   WRONG
#
# A trailing `/rest/v1/` produces request URLs like `/rest/v1/rest/v1/posts` and
# every call fails — reads, auth, and storage alike — with errors that look like
# anything except a bad environment variable. `npm run verify:contract` checks
# this first and refuses to continue.
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (older projects call it the anon key). Safe in the browser:
# it carries no privileges of its own and every row it can reach is decided by
# Row Level Security. Either variable name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The service-role key. Bypasses Row Level Security entirely.
#
# Server-only, and deliberately without a NEXT_PUBLIC_ prefix so Next cannot
# inline it into a client bundle. Used in exactly two places, both of which the
# publishable key genuinely cannot reach: listing `auth.users` and creating
# accounts, on the owner-only /admin/people page.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for MIGRATIONS ONLY.
#
# Supabase → Settings → Database → Connection string → URI. Prefer the Session
# pooler string: the direct-connection host is IPv6-only on newer projects.
#
# The application never uses this. Next.js talks HTTPS to PostgREST with the keys
# above and never opens a Postgres connection — which is why a leaked publishable
# key cannot drop a table. Only `npm run db:migrate` reads this variable.
#
# No NEXT_PUBLIC_ prefix, so it cannot reach a client bundle. Rotate it on that
# same dashboard page whenever you like; nothing at runtime depends on it.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# The blog-drafting MCP server (mcp/). Optional — the website does not read any
# of these, and `npm run build` does not need them.
# ---------------------------------------------------------------------------

# OpenAI key, for generated cover artwork.
#
# THIS ONE COSTS MONEY: one paid image request per `generate_cover_image` call.
# The SDK is configured with `maxRetries: 0` so a failing request is billed once
# rather than three times.
#
# Leaving it blank is a supported configuration, not a broken one. Covers then
# fall back to an ESE-branded typographic card, and `generate_cover_image`
# reports `source: composed-brand-cover` instead of erroring. Drafting works
# either way.
#
# Server-only, and deliberately without a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=

# The image model. Defaults to gpt-image-2 when unset.
OPENAI_IMAGE_MODEL=

# Image quality: low | medium | high | auto. Defaults to medium.
# Higher costs more per call.
OPENAI_IMAGE_QUALITY=

# Which sites the drafting server will write to. Comma-separated; defaults to
# `ese`, which is the only registered site.
#
# There is deliberately no per-site credential convention here: the server reads
# the Supabase variables above and nothing else, so there is no second database
# it could be pointed at by mistake. A second ESE-adjacent site would get its own
# deployment rather than an entry in this list.
ESE_SITES_ENABLED=

# Set to 1 to make every image call fail as if no key were present.
#
# A kill switch for running the drafting server against a real database without
# spending anything on artwork. The test suites set it themselves.
MCP_NO_PAID_CALLS=

# ---------------------------------------------------------------------------
# The remote MCP endpoint (/api/mcp). Optional, and off unless switched on.
#
# This is the second transport over the same eight tools in `mcp/`. The stdio
# server above is for a client that can spawn a local process (Claude Code,
# Claude Desktop); this one is for a client that cannot (ChatGPT), which is the
# entire reason it exists.
#
# ChatGPT connectors will not accept a static API key or a custom header — they
# support OAuth or nothing — and they register themselves via RFC 7591 dynamic
# client registration, so there is no hand-made client_id either. That is what
# forces a real authorization server; see the header of
# supabase/migrations/0004_mcp_oauth.sql.
# ---------------------------------------------------------------------------

# The master switch. Every OAuth and MCP endpoint returns 404 unless this is
# exactly `true`.
#
# Off by default on purpose: deploying the code must not by itself open a write
# path into the database. Only a deliberate environment change can.
#
# Requires supabase/migrations/0004_mcp_oauth.sql to have been applied.
MCP_OAUTH_ENABLED=

# This deployment's absolute origin — no trailing slash, no path.
#
# Every discovery document, the `resource` every token is bound to, and the
# `resource_metadata` pointer in the 401 challenge are built from this. A wrong
# value means a connector fails at its first fetch with nothing useful in the
# error, so the endpoints refuse to serve a guess.
#
# Needed today because `site.canonicalBase` in src/lib/data/ese-content.ts is
# still the placeholder `https://example.com`. Once that is set to the real
# domain this can be left empty — see src/lib/mcp-auth/origin.ts for the
# resolution order, and for why the request's Host header is deliberately not
# consulted.
#
#   MCP_OAUTH_ORIGIN=https://the-real-domain.example
MCP_OAUTH_ORIGIN=
